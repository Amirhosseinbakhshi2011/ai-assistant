# کلید API سرویس هوش مصنوعی (OpenAI یا سازگار)
OPENAI_API_KEY=sk-your-api-key-here

# مدل پیش‌فرض (می‌توانید تغییر دهید)
OPENAI_MODEL=gpt-4o-mini

# آدرس پایه API (برای سرویس‌های سازگار مثل OpenRouter یا Azure)
# برای OpenAI رسمی خالی بگذارید یا https://api.openai.com/v1
OPENAI_BASE_URL=

# تایم‌اوت درخواست‌ها (ثانیه)
REQUEST_TIMEOUT=60

# حداکثر تعداد توکن خروجی
MAX_TOKENS=2048

# دمای پاسخ (۰ تا ۲)
TEMPERATURE=0.7

# زبان پیش‌فرض رابط کاربری (fa یا en)
DEFAULT_LANGUAGE=fa